[Unit]
Description=Run fail-closed Cloudflare R2 orphan GC daily
Documentation=file:/var/www/ai-content/docs/ops/cloudflare-r2-media-rollout.md

[Timer]
Unit=heroai-r2-orphan-gc.service
OnCalendar=*-*-* 02:30:00 Asia/Bangkok
RandomizedDelaySec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
