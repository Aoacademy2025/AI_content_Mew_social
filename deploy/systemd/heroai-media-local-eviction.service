[Unit]
Description=HeroAI verified Cloudflare R2 local media eviction
Documentation=file:/var/www/ai-content/docs/ops/cloudflare-r2-media-rollout.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/www/ai-content/.env.r2.production

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/ai-content
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_PATH=/var/www/ai-content/.env.r2.production
Environment=MEDIA_LOCAL_EVICTION=1
ExecStart=/usr/bin/flock --exclusive --wait 3600 /run/lock/heroai-media-storage.lock /var/www/ai-content/node_modules/.bin/tsx scripts/evict-local-media.ts --apply --deferWhenBusy --olderThanDays=3 --includeStocks --maxObjects=500 --maxBytesMb=51200 --maxRuntimeMin=90

Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
IOSchedulingPriority=7
MemoryMax=2G
# The script stops itself cleanly at --maxRuntimeMin between objects. This is
# only a backstop for a wedged process: above the worst observed run (2h05m
# on 2026-09-21) yet well under the 4h timer, so two runs can never overlap
# and queue behind the flock.
TimeoutStartSec=2h
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/ai-content
ReadOnlyPaths=/var/www/ai-content/.env.r2.production
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
