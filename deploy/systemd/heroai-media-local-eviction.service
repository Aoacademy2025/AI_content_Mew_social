[Unit]
Description=HeroAI verified Cloudflare R2 local media eviction
Documentation=file:/var/www/ai-content/docs/ops/cloudflare-r2-media-rollout.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/www/ai-content/.env.r2.production

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/ai-content
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_PATH=/var/www/ai-content/.env.r2.production
Environment=MEDIA_LOCAL_EVICTION=1
ExecStart=/usr/bin/flock --exclusive --wait 3600 /run/lock/heroai-media-storage.lock /var/www/ai-content/node_modules/.bin/tsx scripts/evict-local-media.ts --apply --olderThanDays=3 --includeStocks --maxObjects=250 --maxBytesMb=20480

Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=2G
TimeoutStartSec=infinity
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/ai-content
ReadOnlyPaths=/var/www/ai-content/.env.r2.production
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
