[Unit]
Description=Check reviewed R2 deletion canaries after their 24-hour grace
Documentation=file:/var/www/ai-content/docs/ops/cloudflare-r2-media-rollout.md

[Timer]
Unit=heroai-r2-remote-gc-canary.service
OnCalendar=*-*-* 01:30:00 Asia/Bangkok
RandomizedDelaySec=2min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
