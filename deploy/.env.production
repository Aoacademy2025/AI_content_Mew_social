# ============================================================
# AI Content — Production Environment Variables
# Copy ไปที่ /var/www/ai-content/.env แล้วกรอกค่าให้ครบ
# ============================================================

# Database — PostgreSQL on VPS
# NOTE: before deploying to VPS, change prisma/schema.prisma provider to "postgresql":
#   sed -i 's/provider = "sqlite"/provider = "postgresql"/' prisma/schema.prisma
DATABASE_URL="postgresql://ai_content:YOUR_DB_PASSWORD@localhost:5432/ai_content"

# NextAuth
NEXTAUTH_SECRET="ใส่ random string ยาวๆ ที่นี่"
NEXTAUTH_URL="https://yourdomain.com"

# Hero AI Bundle lifecycle sync (same server-only value in all three services)
BUNDLE_SYNC_SECRET=""

# Pexels
PEXELS_API_KEY=""

# Pixabay
PIXABAY_API_KEY=""

# Replicate (BiRefNet)
REPLICATE_API_TOKEN=""

# Blob Storage (ถ้าใช้ Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Email (ถ้าใช้)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# n8n (ถ้าใช้)
N8N_WEBHOOK_URL=""
# Support tickets → n8n (falls back to N8N_WEBHOOK_URL if empty)
N8N_SUPPORT_WEBHOOK_URL="https://n8n-gla2.onrender.com/webhook/Contactus"
