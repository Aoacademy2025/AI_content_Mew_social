# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Runtime / build cache
/.tmp

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-staging/
/.next.old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev*.log

# local build artifacts
*.tar.gz

# env files (can opt-in for committing if needed)
.env*
!deploy/.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# large media files
/stocks/
/public/renders/
/data/brand-assets/
/uploads/

# database — each environment uses its own file, never share via git
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
*.jpg
# Reviewed, versioned Brand setup sample assets.
!/public/style-packs/2026-09-06/*.jpg

# ── Dev-only files that should NOT be deployed to VPS ──────────────
# Node CPU profiles (created when running with --prof)
*.cpuprofile
*.heapsnapshot
*.heapprofile

# Test / scratch files
test-*.mjs
test-*.js
test-*.txt
test-*.ts
scratch-*
tmp-*
*.local

# Analysis / planning docs (use git for source, not bundled artifacts)
pricing-analysis.*
*-analysis.html
*-analysis.jpg

# Local UI design mockups (preview only — do NOT bundle into production)
public/dashboard-designs.html
public/*-designs.html
public/*-mockup.html

# Local install helpers — VPS uses its own setup (Linux pm2)
install-mac.sh
install-windows.bat

# Editor / OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Skills / agent state (local-only)
skills-lock.json
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/mewshort/
!.claude/skills/mewshort/SKILL.md
.cursor/

# IDE TS build cache (rebuilds on VPS anyway)
tsconfig.tsbuildinfo

# Scratch files (verify scripts, ad-hoc screenshots)
_vc-*
_verify-*

.superpowers/
.worktrees/

# Local source PNGs/manifests for the Brand Visual System qualification runs.
# Reviewed card derivatives live under public/brand-visual-formats instead.
artifacts/brand-visual-quality-gate/

# clerk configuration (can include secrets)
/.clerk/

# agent/tool scratch (ไม่ควรเข้า git)
.orca/
.playwright-mcp/
__pycache__/
artifacts/
/.tmp/hero-voice-clone-canary-reference.json
