generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String?   @unique
  name                  String
  email                 String    @unique
  password              String?
  googleId              String?   @unique
  image                 String?
  role                  Role      @default(USER)
  plan                  Plan      @default(FREE)
  usageCount            Int       @default(0)
  usageLimit            Int       @default(2)
  usagePeriodStartedAt  DateTime?
  openaiKey             String?
  geminiKey             String?
  heygenKey             String?
  elevenlabsKey         String?
  pexelsKey             String?
  pixabayKey            String?
  kieKey                String?
  unsplashKey           String?
  flickrKey             String?
  avatar                String?
  heygenAvatarId        String?
  heygenAvatarsCache    String? // durable fallback: last successful HeyGen avatar list (JSON {k,avatars,talkingPhotos}); served stale when HeyGen is slow so the picker/preview keep working
  heygenAvatarsCachedAt DateTime? // when heygenAvatarsCache was last refreshed (for max-age on the stale fallback)
  elevenlabsVoiceId     String?
  ttsProvider           String?   @default("gemini")
  geminiVoiceName       String?   @default("Aoede")
  suspended             Boolean   @default(false)
  planExpiresAt         DateTime?
  onboardingDismissedAt DateTime?
  // Phase 2 — subscriptions (card auto-renew cohort)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?
  subStatus             String? // active | past_due | canceled
  billingPeriod         String? // monthly | annual
  cancelAtPeriodEnd     Boolean   @default(false) // portal-scheduled cancel; resume clears it
  cancelAt              DateTime? // exact lapse date from Stripe sub.cancel_at
  // Free trial (public 7-day PRO trial, no card)
  trialStartedAt        DateTime? // set once; never cleared (one-trial-per-user guard)
  trialEndsAt           DateTime? // end of the active unconverted trial; cleared on conversion/revert
  // Hero AI Bundle is an overlay, independent from Studio's own Stripe/trial/
  // admin-paid entitlement. Never reuse planExpiresAt for this source: revoke
  // must remove only Bundle access and preserve every other valid source.
  bundleGrantId         String?
  bundleSubscriptionId  String?
  bundleAccessExpiresAt DateTime?
  bundleStatus          String? // ACTIVE | REVOKED
  bundleBillingPeriod   String? // monthly | annual, sourced from Bundle checkout
  bundleAmountThb       Int? // actual paid amount for the current Bundle term/invoice
  bundleLastEventId     String?
  bundleQuotaGrantId    String?
  bundleCreditsGrantId  String?
  bundlePrimary         Boolean   @default(false)
  minutesUsed           Float     @default(0)
  minutesLimit          Int       @default(0)
  aiAudioMinutesUsed    Float     @default(0) // managed Gemini/OmniVoice audio-minutes (TTS+transcribe) per usage window; ceiling = minutesLimit × AI_AUDIO_CEILING_MULT
  aiTextCallsUsed       Float     @default(0) // managed-Gemini text-LLM call count (keywords/ranker/content/analyze/split) per usage window; ceiling = minutesLimit × AI_TEXT_CALLS_MULT
  geminiKeyMode         String    @default("byok")
  affiliateRefCode      String? // hero-affiliate refCode stamped once at first sign-in; never updated after
  resetToken            String?
  resetExpires          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  styles                          Style[]
  contents                        Content[]
  videos                          Video[]
  mcpTokens                       McpToken[]
  videoJobs                       VideoJob[]
  images                          GeneratedImage[]
  notifications                   Notification[]
  supportTickets                  SupportTicket[]
  couponRedemptions               CouponRedemption[]
  promotionalCreditGrants         PromotionalCreditGrant[]
  payments                        Payment[]
  telemetryEvents                 TelemetryEvent[]
  productUpdateReads              ProductUpdateRead[]
  userMusic                       UserMusic[]
  avatarPresets                   AvatarPreset[]
  editorProjects                  EditorProject[]
  brandAssets                     BrandAsset[]
  brandPreference                 BrandPreference?
  editorStylePresets              EditorStylePreset[]
  aiGenerationJobs                AiGenerationJob[]
  brandProfiles                   BrandProfile[]
  scripts                         Script[]
  scriptGenerationUsages          ScriptGenerationUsage[]
  contentPreflights               ContentPreflight[]
  projectVisualBeats              ProjectVisualBeat[]
  brandLookPreviewBatches         BrandLookPreviewBatch[]
  sceneRerollDerivatives          SceneRerollDerivative[]
  starterAiImageAllowances        StarterAiImageAllowance[]
  administratorGrants             AdministratorGrant[]
  conversionTrialAiImageAllowance ConversionTrialAiImageAllowance?
  userVoices                      UserVoice[]
}

// Private voice-clone references. The normalized WAV bytes live outside
// public/ and are exposed only through owner-authenticated routes.
model UserVoice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  refText        String
  filename       String   @unique
  durationMs     Int
  consentAt      DateTime @default(now())
  consentVersion String   @default("voice-clone-v1")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

/// Explicit non-cash access granted by an administrator. A paid-looking value
/// in User.plan is presentation state only; this append-only record is the
/// evidence used by paid-feature authorization and audit reporting.
model AdministratorGrant {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan
  reason       String
  startsAt     DateTime  @default(now())
  expiresAt    DateTime?
  permanent    Boolean   @default(false)
  grantedById  String
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@index([startsAt, expiresAt])
}

/// Email-backed Bundle entitlement. The purchase may arrive before a Clerk
/// account exists; the next entitlement sync materializes it onto User.
model BundleEntitlement {
  email           String   @id
  grantId         String
  subscriptionId  String?
  status          String
  accessEndsAt    DateTime
  billingPeriod   String?
  amountThb       Int?
  lastEventId     String   @unique
  eventOccurredAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status, accessEndsAt])
}

model Style {
  id                String   @id @default(cuid())
  name              String
  sampleText        String?
  sampleUrl         String?
  instructionPrompt String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Content {
  id            String   @id @default(cuid())
  sourceText    String?
  sourceUrl     String?
  styleId       String?
  language      Language @default(TH)
  imageModel    String?  @default("nanobanana")
  videoDuration Int?
  headline      String?
  subheadline   String?
  body          String?
  hashtags      String?
  imagePrompt   String?
  visualNotes   String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos        Video[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  id              String         @id @default(cuid())
  contentId       String?
  content         Content?       @relation(fields: [contentId], references: [id])
  projectId       String?
  project         EditorProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  avatarModel     String
  voiceModel      String
  imageModel      String?
  sceneCount      Int
  script          String?
  sceneMapping    String?
  generatedImages String?
  audioUrl        String?
  videoUrl        String?
  avatarVideoUrl  String?
  thumbnail       String?
  thumbnailConfig String? // JSON: { seekTime, textLayers } for thumbnail editor
  renderConfig    String? // JSON: shortVideoConfig for Remotion thumbnail
  status          VideoStatus    @default(PENDING)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expiresAt       DateTime?

  @@index([projectId])
}

model McpToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  name       String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AvatarPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId  String // HeyGen avatar_id or talking_photo_id
  scale     Float    @default(1)
  offsetX   Float    @default(0)
  offsetY   Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, avatarId])
  @@index([userId])
}

model EditorProject {
  id                      String                  @id @default(cuid())
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                   String                  @default("New Project")
  status                  String                  @default("draft") // draft|rendering|post|exporting|exported|archived
  draftJson               String?
  draftRevision           Int                     @default(0)
  activeJobId             String?
  activeExportJobId       String?
  latestVideoId           String?
  brandProfileRevisionId  String?
  projectLookJson         String?
  projectLookUpdatedAt    DateTime?
  treatmentPresetId       String?
  treatmentPresetVersion  String?
  treatmentPinSource      String?
  treatmentPinnedAt       DateTime?
  lastOpenedAt            DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  jobs                    VideoJob[]
  videos                  Video[]
  brandAssets             BrandAsset[]
  brandProfileRevision    BrandProfileRevision?   @relation(fields: [brandProfileRevisionId], references: [id], onDelete: SetNull)
  contentPreflights       ContentPreflight[]
  visualBeats             ProjectVisualBeat[]
  brandLookPreviewBatches BrandLookPreviewBatch[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
  @@index([activeJobId])
  @@index([activeExportJobId])
  @@index([latestVideoId])
  @@index([brandProfileRevisionId])
  @@index([treatmentPresetId, treatmentPresetVersion])
}

model BrandAsset {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           EditorProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  storageKey        String              @unique
  originalName      String
  mimeType          String
  sizeBytes         Int
  width             Int
  height            Int
  retiredAt         DateTime?
  lifecycleRevision Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  defaultFor        BrandPreference?    @relation("DefaultBrandAsset")
  stylePresets      EditorStylePreset[]

  @@index([userId, createdAt])
  @@index([projectId])
}

model BrandPreference {
  userId         String     @id
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAssetId String     @unique
  defaultAsset   BrandAsset @relation("DefaultBrandAsset", fields: [defaultAssetId], references: [id], onDelete: Cascade)
  position       String     @default("top-right")
  sizePct        Float      @default(18)
  opacity        Float      @default(0.9)
  enabled        Boolean    @default(true)
  updatedAt      DateTime   @updatedAt
}

model EditorStylePreset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // subtitle | logo
  name         String
  nameKey      String
  configJson   String
  brandAssetId String?
  brandAsset   BrandAsset? @relation(fields: [brandAssetId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, kind, nameKey])
  @@index([userId, kind, updatedAt])
  @@index([brandAssetId])
}

model BrandProfile {
  id                   String                  @id @default(cuid())
  userId               String
  name                 String // ชื่อแบรนด์/โปรไฟล์
  niche                String // นิช เช่น "การเงินส่วนบุคคล"
  audience             String // กลุ่มเป้าหมาย เช่น "มนุษย์เงินเดือน 25-35"
  tone                 String // โทนเสียง เช่น "เป็นกันเอง ขี้เล่น มีสาระ"
  bannedWords          String                  @default("[]") // JSON string array
  ctaStyle             String                  @default("follow") // follow | comment | share | sell
  language             String                  @default("th")
  sampleText           String? // แหล่งที่ใช้ตอน analyze (ถ้ามี)
  sampleUrl            String?
  analysisNotes        String? // โน้ตสไตล์การเขียนที่ LLM สกัดได้
  activeRevisionNumber Int                     @default(0) // 0 = legacy profile not published into Brand Visual System yet
  frozenAt             DateTime? // downgrade overflow: readable/pinned, unavailable for new projects
  archivedAt           DateTime? // hidden from new work; immutable revisions stay pinned to historical projects
  lastUsedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts              Script[]
  draft                BrandProfileDraft?
  revisions            BrandProfileRevision[]
  previewBatches       BrandLookPreviewBatch[]

  @@index([userId])
  @@index([userId, frozenAt, updatedAt])
  @@index([userId, archivedAt, updatedAt])
}

// One mutable working copy per Brand Profile. The typed payload is validated by
// the Brand Profile Library module; edits and previews never affect active work.
model BrandProfileDraft {
  id                 String                  @id @default(cuid())
  brandProfileId     String                  @unique
  baseRevisionNumber Int                     @default(0)
  payloadJson        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  brandProfile       BrandProfile            @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  previewBatches     BrandLookPreviewBatch[]
}

// Immutable snapshot. A project pins this row, not BrandProfile's mutable head.
// visualRecipeJson stores the resolved format/recipe so future catalog changes
// cannot silently alter an old render (ADR-0005).
model BrandProfileRevision {
  id                String                  @id @default(cuid())
  brandProfileId    String
  sourceVideoJobId  String?                 @unique // durable idempotency for completed-clip promotion; intentionally no FK so history survives job retention
  sourcePreflightId String?                 @unique // durable idempotency for Project Look promotion before or after render
  version           Int
  payloadJson       String
  visualRecipeJson  String
  source            String                  @default("manual") // manual | project-look
  createdAt         DateTime                @default(now())
  brandProfile      BrandProfile            @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  projects          EditorProject[]
  previewBatches    BrandLookPreviewBatch[]

  @@unique([brandProfileId, version])
  @@index([brandProfileId, createdAt])
}

// Cached lazy analysis of one Narrative Source version. A changed source gets a
// new hash/row; the original remains auditable and reusable for exact rerenders.
model ContentPreflight {
  id                      String              @id @default(cuid())
  userId                  String
  projectId               String
  narrativeSourceKind     String // ai-script | creator-script | upload-transcript
  sourceHash              String
  analyzerVersion         String
  contentDomain           String
  dominantNarrativeMode   String?
  suggestedVisualFormatId String
  suggestedTreatmentJson  String
  suggestedTreatmentPresetId      String?
  suggestedTreatmentPresetVersion String?
  rankedTreatmentPresetIdsJson    String              @default("[]")
  treatmentRecommendationRationale String?
  storyEntitiesJson                String              @default("[]")
  formatRecommendationJson         String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                 EditorProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visualBeats             ProjectVisualBeat[]

  @@unique([projectId, sourceHash, analyzerVersion])
  @@index([userId, createdAt])
  @@index([projectId, updatedAt])
}

// Structured story intent for one B-roll window. The asset is deliberately not
// overwritten when status becomes outdated; regeneration is a separate action.
model ProjectVisualBeat {
  id                    String           @id @default(cuid())
  userId                String
  projectId             String
  preflightId           String
  beatKey               String
  sequence              Int
  startMs               Int?
  endMs                 Int?
  sourceExcerptHash     String
  beatJson              String
  status                String           @default("current") // current | outdated
  existingAssetUrl      String?
  existingImageJobId    String?
  generationIdentityKey String?
  outdatedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               EditorProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preflight             ContentPreflight @relation(fields: [preflightId], references: [id], onDelete: Cascade)

  @@unique([preflightId, beatKey])
  @@index([projectId, status, sequence])
  @@index([existingImageJobId])
}

// Server-owned binding between a paid Scene Reroll image and the exact MP4
// derivative offered to Apply. Completion consumes a ready row atomically.
model SceneRerollDerivative {
  id                 String    @id @default(cuid())
  userId             String
  imageJobId         String
  sourceVideoJobId   String
  sceneIndex         Int
  src                String    @unique
  status             String    @default("ready") // ready | applied
  appliedVideoJobId  String?
  createdAt          DateTime  @default(now())
  appliedAt          DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, imageJobId])
  @@index([sourceVideoJobId, sceneIndex])
  @@index([status, createdAt])
}

// One logical Brand Look Preview, backed by three independently durable image
// jobs (or three reused project assets). Partial failures can be retried per item.
model BrandLookPreviewBatch {
  id                     String                 @id @default(cuid())
  userId                 String
  requestId              String
  projectId              String?
  brandProfileId         String?
  brandProfileDraftId    String?
  brandProfileRevisionId String?
  status                 String                 @default("queued") // queued | in_progress | completed | partial | failed
  sourceSnapshotJson     String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  finishedAt             DateTime?
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                EditorProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  brandProfile           BrandProfile?          @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  brandProfileDraft      BrandProfileDraft?     @relation(fields: [brandProfileDraftId], references: [id], onDelete: SetNull)
  brandProfileRevision   BrandProfileRevision?  @relation(fields: [brandProfileRevisionId], references: [id], onDelete: SetNull)
  items                  BrandLookPreviewItem[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([brandProfileId, createdAt])
  @@index([status, updatedAt])
}

model BrandLookPreviewItem {
  id                String                @id @default(cuid())
  batchId           String
  phase             String // hook | explain | close
  sourceType        String // generated | reused
  aiGenerationJobId String?               @unique
  outputUrl         String?
  status            String                @default("queued") // queued | in_progress | completed | failed
  errorCode         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  batch             BrandLookPreviewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  aiGenerationJob   AiGenerationJob?      @relation(fields: [aiGenerationJobId], references: [id], onDelete: SetNull)

  @@unique([batchId, phase])
  @@index([batchId, status])
  @@index([status, updatedAt])
}

model Script {
  id              String        @id @default(cuid())
  userId          String
  brandProfileId  String?
  topic           String
  durationSec     Int           @default(60) // 30 | 60 | 90
  hookFormula     String? // key จาก HOOK_FORMULAS
  structure       String? // key จาก STORY_STRUCTURES
  hookText        String
  bodyText        String // หลายบรรทัด: 1 บรรทัด = 1 ประโยค
  ctaText         String
  status          String        @default("draft") // draft | sent
  editorProjectId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfile    BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Durable product-quota ledger for Hero Script full generations. This is
// intentionally separate from Script rows: deleting a saved script must not
// restore a consumed FREE/TRIAL generation, and a generation is reserved
// before the server-paid provider call begins.
model ScriptGenerationUsage {
  id          String    @id @default(cuid())
  userId      String
  bucket      String // free | trial
  slot        Int // 1..cohort limit; unique slot makes concurrent admission atomic
  status      String    @default("reserved") // reserved | succeeded | failed
  expiresAt   DateTime // stale-reservation recovery; ignored after this time
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket, slot])
  @@index([userId, bucket, createdAt])
  @@index([status, expiresAt])
}

model VideoJob {
  id                           String         @id @default(cuid())
  userId                       String
  user                         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId                    String?
  project                      EditorProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentPreflightId           String?
  projectVisualContextJson     String?
  brandVisualAcceptanceJson    String?
  videoId                      String?
  type                         String         @default("create")
  status                       String         @default("queued") // queued|processing|waiting_provider|done|failed|canceled
  currentStep                  String?
  progress                     Int            @default(0)
  inputJson                    String
  outputJson                   String?
  errorMessage                 String?
  errorCode                    String?
  errorProvider                String?
  reservationRefundPending     Boolean        @default(false)
  reservationRefundReason      String?
  reservationRefundAttempts    Int            @default(0)
  idempotencyKey               String?
  idempotencyFingerprint       String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  startedAt                    DateTime?
  finishedAt                   DateTime?
  mediaExpiresAt               DateTime?
  providerCheckpointJson       String?
  providerNextPollAt           DateTime?
  fundingState                 String         @default("none") // none|reserved|transferred|settled|refunded
  fundedMeteredMinutes         Int?
  fundedCreditsSpent           Int?
  fundedCreditsFromGranted     Int?
  fundedCreditsFromPromotional Int?
  fundedCreditFundingJson      String?
  fundedCreditBalanceAfter     Int?
  walletFundingAuthorized      Boolean        @default(false)

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([contentPreflightId])
  @@index([createdAt]) // DB-1: admin/insights does createdAt-range scans across ALL users
  @@index([mediaExpiresAt])
}

model ToolCallAudit {
  id           String   @id @default(cuid())
  userId       String?
  toolName     String
  status       String // ok | denied | error
  durationMs   Int?
  requestJson  String?
  responseJson String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([toolName, createdAt])
}

enum Role {
  ADMIN
  USER
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Language {
  TH
  EN
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  VIDEO_COMPLETED
  VIDEO_FAILED
  LIMIT_WARNING
  LIMIT_REACHED
  NEW_USER
  ERROR_SYSTEM
}

model ProductUpdate {
  id          String                  @id @default(cuid())
  version     String
  title       String
  summary     String
  body        String?
  category    ProductUpdateCategory   @default(IMPROVEMENT)
  importance  ProductUpdateImportance @default(BANNER)
  state       ProductUpdateState      @default(DRAFT)
  isPinned    Boolean                 @default(false)
  targetPath  String?
  ctaLabel    String?
  ctaHref     String?
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  reads       ProductUpdateRead[]

  @@index([state, publishedAt])
  @@index([category, publishedAt])
  @@index([isPinned, publishedAt])
}

model ProductUpdateRead {
  id       String        @id @default(cuid())
  updateId String
  update   ProductUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime      @default(now())

  @@unique([updateId, userId])
  @@index([userId, readAt])
}

