model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  plan                  Plan               @default(PRO)
  durationDays          Int                @default(30) // 0 = permanent
  maxUses               Int                @default(1)
  usedCount             Int                @default(0)
  expiresAt             DateTime?
  type                  String             @default("GRANT") // GRANT | DISCOUNT
  percentOff            Int? // 1-100, DISCOUNT only
  discountDuration      String? // "once" | "forever", DISCOUNT only
  stripeCouponId        String? // Stripe Coupon id (DISCOUNT)
  stripePromotionCodeId String? // Stripe Promotion Code id (DISCOUNT)
  isActive              Boolean            @default(true)
  stackingPolicy        String             @default("SAFE_APPEND") // SAFE_APPEND | REJECT_EXISTING
  promoCredits          Int                @default(0)
  promoCreditTtlDays    Int                @default(30)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt
  redemptions           CouponRedemption[]
  auditLogs             CouponAuditLog[]
}

model CouponRedemption {
  id                   String                  @id @default(cuid())
  couponId             String
  coupon               Coupon                  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt           DateTime                @default(now())
  outcome              String                  @default("LEGACY") // LEGACY | ACTIVATED | SCHEDULED | PROMO_ONLY
  entitlementPlan      Plan?
  entitlementStartsAt  DateTime?
  entitlementExpiresAt DateTime?
  promotionalGrant     PromotionalCreditGrant?

  @@unique([couponId, userId])
  @@index([userId, entitlementStartsAt, entitlementExpiresAt])
}

/// Expiring campaign credits are independent from the monthly and purchased
/// wallet buckets. Individual rows preserve earliest-expiry spending and exact
/// refund provenance when multiple campaigns overlap.
model PromotionalCreditGrant {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponRedemptionId String           @unique
  couponRedemption   CouponRedemption @relation(fields: [couponRedemptionId], references: [id], onDelete: Restrict)
  initialAmount      Int
  remainingAmount    Int
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId, expiresAt])
}

/// Append-only history for coupon administration. Used coupons are disabled,
/// never hard-deleted, so their commercial evidence remains auditable.
model CouponAuditLog {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  actorUserId String
  action      String // CREATE | UPDATE | DISABLE | ENABLE
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([actorUserId, createdAt])
}

// MON-10 (audited 2026-07-07): a user can legitimately churn through RESERVED → RELEASED →
// RESERVED (abandoned checkout, retry) many times, so `@@unique([userId])` on this table would
// wrongly forbid a normal retry. What we actually want to guard is "one CONFIRMED row per user",
// which needs a PARTIAL/filtered unique index (`WHERE status = 'CONFIRMED'`) — SQLite/Prisma has
// no filtered-unique support, so that constraint isn't cleanly expressible here. Instead, the
// member-check + coupon-claim in `claimSeat()` (src/lib/founding.ts) run inside one
// `$transaction` — see the comment there for exactly what race that closes and what it doesn't.
model FoundingReservation {
  id              String    @id @default(cuid())
  userId          String
  stripeSessionId String    @unique
  status          String    @default("RESERVED") // RESERVED | CONFIRMED | RELEASED
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  releasedAt      DateTime?

  @@index([userId])
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId     String        @unique
  stripePaymentIntent String?
  plan                Plan
  amount              Int // satang / cents
  currency            String        @default("thb")
  status              PaymentStatus @default(PENDING)
  periodDays          Int           @default(30)
  createdAt           DateTime      @default(now())
  paidAt              DateTime?
  // Off-Stripe (bank-transfer / external) payments recorded by an admin. Additive; a manual
  // PAID row counts in revenue-cohorts (จ่ายจริง/MRR/cash) exactly like a Stripe one. See
  // src/app/api/admin/manual-payment/route.ts. Never hard-deleted — soft-voided to VOIDED.
  manual              Boolean       @default(false)
  note                String? // admin free-text (e.g. "โอนธนาคาร · founder")
  recordedBy          String? // admin userId who recorded it

  @@index([status]) // DB-1: admin/insights + revenue-cohorts filter/scan by status (previously zero indexes besides the PK/unique)
}

// Idempotency ledger for Stripe webhooks. Stripe delivers events "at least once"; we record
// each processed event.id and skip duplicates so plan activation / renewal extension can't run
// twice for the same event. Additive table — flag-independent.
model StripeWebhookEvent {
  id          String   @id // Stripe event.id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

model TelemetryEvent {
  id         String   @id @default(cuid())
  dedupeKey  String?  @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  name       String
  category   String   @default("product") // product | pipeline | performance | error
  source     String   @default("client") // client | server
  path       String?
  step       String?
  status     String?
  durationMs Int?
  value      Float?
  properties String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([category, createdAt])
  @@index([step, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOIDED // admin soft-void of a MANUAL payment — drops out of PAID cohorts, keeps the audit row
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Physical media catalog for the local -> R2 migration. Existing Video/VideoJob
// URLs remain authoritative ownership references; this row records where the
// immutable bytes are stored and whether the remote copy has been verified.
model MediaObject {
  id             String    @id @default(cuid())
  area           String
  filename       String
  objectKey      String    @unique
  contentType    String
  sizeBytes      BigInt
  sha256         String?
  remoteFilename String?
  r2Etag         String?
  remoteState    String    @default("none")
  localState     String    @default("present")
  localMtimeMs   BigInt?
  producedAt     DateTime  @default(now())
  lastVerifiedAt DateTime?
  nextRetryAt    DateTime?
  lastErrorCode  String?
  attempts       Int       @default(0)
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([area, filename])
  @@index([remoteState, nextRetryAt])
  @@index([localState, producedAt])
}

model Music {
  id        String   @id @default(cuid())
