  FEATURE
  IMPROVEMENT
  FIX
  PATCH
  KNOWN_ISSUE
  IN_PROGRESS
}

enum ProductUpdateImportance {
  SILENT
  BANNER
  MODAL
}

enum ProductUpdateState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

