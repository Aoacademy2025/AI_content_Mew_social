generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String?   @unique
  name                  String
  email                 String    @unique
  password              String?
  googleId              String?   @unique
  image                 String?
  role                  Role      @default(USER)
  plan                  Plan      @default(FREE)
  usageCount            Int       @default(0)
  usageLimit            Int       @default(2)
  usagePeriodStartedAt  DateTime?
  openaiKey             String?
  geminiKey             String?
  heygenKey             String?
  elevenlabsKey         String?
  pexelsKey             String?
  pixabayKey            String?
  kieKey                String?
  unsplashKey           String?
  flickrKey             String?
  avatar                String?
  heygenAvatarId        String?
  heygenAvatarsCache    String? // durable fallback: last successful HeyGen avatar list (JSON {k,avatars,talkingPhotos}); served stale when HeyGen is slow so the picker/preview keep working
  heygenAvatarsCachedAt DateTime? // when heygenAvatarsCache was last refreshed (for max-age on the stale fallback)
  elevenlabsVoiceId     String?
  ttsProvider           String?   @default("elevenlabs")
  geminiVoiceName       String?   @default("Aoede")
  suspended             Boolean   @default(false)
  planExpiresAt         DateTime?
  onboardingDismissedAt DateTime?
  // Phase 2 — subscriptions (card auto-renew cohort)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?
  subStatus             String? // active | past_due | canceled
  billingPeriod         String? // monthly | annual
  cancelAtPeriodEnd     Boolean   @default(false) // portal-scheduled cancel; resume clears it
  cancelAt              DateTime? // exact lapse date from Stripe sub.cancel_at
  // Free trial (public 7-day PRO trial, no card)
  trialStartedAt        DateTime? // set once; never cleared (one-trial-per-user guard)
  trialEndsAt           DateTime? // end of the active unconverted trial; cleared on conversion/revert
  minutesUsed           Float     @default(0)
  minutesLimit          Int       @default(0)
  aiAudioMinutesUsed    Float     @default(0) // managed Gemini/OmniVoice audio-minutes (TTS+transcribe) per usage window; ceiling = minutesLimit × AI_AUDIO_CEILING_MULT
  aiTextCallsUsed       Float     @default(0) // managed-Gemini text-LLM call count (keywords/ranker/content/analyze/split) per usage window; ceiling = minutesLimit × AI_TEXT_CALLS_MULT
  geminiKeyMode         String    @default("byok")
  affiliateRefCode      String?   // hero-affiliate refCode stamped once at first sign-in; never updated after
  resetToken            String?
  resetExpires          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  styles             Style[]
  contents           Content[]
  videos             Video[]
  mcpTokens          McpToken[]
  videoJobs          VideoJob[]
  images             GeneratedImage[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  couponRedemptions  CouponRedemption[]
  payments           Payment[]
  telemetryEvents    TelemetryEvent[]
  productUpdateReads ProductUpdateRead[]
  userMusic          UserMusic[]
  avatarPresets      AvatarPreset[]
  editorProjects     EditorProject[]
  brandAssets        BrandAsset[]
  brandPreference    BrandPreference?
  editorStylePresets EditorStylePreset[]
  aiGenerationJobs   AiGenerationJob[]
  brandProfiles      BrandProfile[]
  scripts            Script[]
  scriptGenerationUsages ScriptGenerationUsage[]
}

model Style {
  id                String   @id @default(cuid())
  name              String
  sampleText        String?
  sampleUrl         String?
  instructionPrompt String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Content {
  id            String   @id @default(cuid())
  sourceText    String?
  sourceUrl     String?
  styleId       String?
  language      Language @default(TH)
  imageModel    String?  @default("nanobanana")
  videoDuration Int?
  headline      String?
  subheadline   String?
  body          String?
  hashtags      String?
  imagePrompt   String?
  visualNotes   String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos        Video[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  id              String         @id @default(cuid())
  contentId       String?
  content         Content?       @relation(fields: [contentId], references: [id])
  projectId       String?
  project         EditorProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  avatarModel     String
  voiceModel      String
  imageModel      String?
  sceneCount      Int
  script          String?
  sceneMapping    String?
  generatedImages String?
  audioUrl        String?
  videoUrl        String?
  avatarVideoUrl  String?
  thumbnail       String?
  thumbnailConfig String? // JSON: { seekTime, textLayers } for thumbnail editor
  renderConfig    String? // JSON: shortVideoConfig for Remotion thumbnail
  status          VideoStatus    @default(PENDING)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expiresAt       DateTime?

  @@index([projectId])
}

model McpToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  name       String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AvatarPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId  String // HeyGen avatar_id or talking_photo_id
  scale     Float    @default(1)
  offsetX   Float    @default(0)
  offsetY   Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, avatarId])
  @@index([userId])
}

model EditorProject {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String     @default("New Project")
  status        String     @default("draft") // draft|rendering|post|exporting|exported|archived
  draftJson     String?
  draftRevision Int        @default(0)
  activeJobId   String?
  activeExportJobId String?
  latestVideoId String?
  lastOpenedAt  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  jobs          VideoJob[]
  videos        Video[]
  brandAssets   BrandAsset[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
  @@index([activeJobId])
  @@index([activeExportJobId])
  @@index([latestVideoId])
}

model BrandAsset {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         EditorProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  storageKey      String           @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  width           Int
  height          Int
  retiredAt          DateTime?
  lifecycleRevision Int       @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  defaultFor      BrandPreference? @relation("DefaultBrandAsset")
  stylePresets    EditorStylePreset[]

  @@index([userId, createdAt])
  @@index([projectId])
}

model BrandPreference {
  userId         String     @id
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAssetId String     @unique
  defaultAsset   BrandAsset @relation("DefaultBrandAsset", fields: [defaultAssetId], references: [id], onDelete: Cascade)
  position       String     @default("top-right")
  sizePct        Float      @default(18)
  opacity        Float      @default(0.9)
  enabled        Boolean    @default(true)
  updatedAt      DateTime   @updatedAt
}

model EditorStylePreset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // subtitle | logo
  name         String
  nameKey      String
  configJson   String
  brandAssetId String?
  brandAsset   BrandAsset? @relation(fields: [brandAssetId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, kind, nameKey])
  @@index([userId, kind, updatedAt])
  @@index([brandAssetId])
}

model BrandProfile {
  id            String   @id @default(cuid())
  userId        String
  name          String                    // ชื่อแบรนด์/โปรไฟล์
  niche         String                    // นิช เช่น "การเงินส่วนบุคคล"
  audience      String                    // กลุ่มเป้าหมาย เช่น "มนุษย์เงินเดือน 25-35"
  tone          String                    // โทนเสียง เช่น "เป็นกันเอง ขี้เล่น มีสาระ"
  bannedWords   String   @default("[]")   // JSON string array
  ctaStyle      String   @default("follow") // follow | comment | share | sell
  language      String   @default("th")
  sampleText    String?                   // แหล่งที่ใช้ตอน analyze (ถ้ามี)
  sampleUrl     String?
  analysisNotes String?                   // โน้ตสไตล์การเขียนที่ LLM สกัดได้
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts       Script[]

  @@index([userId])
}

model Script {
  id              String   @id @default(cuid())
  userId          String
  brandProfileId  String?
  topic           String
  durationSec     Int      @default(60)   // 30 | 60 | 90
  hookFormula     String?                 // key จาก HOOK_FORMULAS
  structure       String?                 // key จาก STORY_STRUCTURES
  hookText        String
  bodyText        String                  // หลายบรรทัด: 1 บรรทัด = 1 ประโยค
  ctaText         String
  status          String   @default("draft") // draft | sent
  editorProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfile    BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Durable product-quota ledger for Hero Script full generations. This is
// intentionally separate from Script rows: deleting a saved script must not
// restore a consumed FREE/TRIAL generation, and a generation is reserved
// before the server-paid provider call begins.
model ScriptGenerationUsage {
  id          String    @id @default(cuid())
  userId      String
  bucket      String // free | trial
  slot        Int // 1..cohort limit; unique slot makes concurrent admission atomic
  status      String    @default("reserved") // reserved | succeeded | failed
  expiresAt   DateTime // stale-reservation recovery; ignored after this time
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket, slot])
  @@index([userId, bucket, createdAt])
  @@index([status, expiresAt])
}

model VideoJob {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        EditorProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  videoId        String?
  type           String         @default("create")
  status         String         @default("queued") // queued|processing|waiting_provider|done|failed|canceled
  currentStep    String?
  progress       Int            @default(0)
  inputJson      String
  outputJson     String?
  errorMessage   String?
  errorCode      String?
  errorProvider  String?
  reservationRefundPending  Boolean  @default(false)
  reservationRefundReason   String?
  reservationRefundAttempts Int      @default(0)
  idempotencyKey         String?
  idempotencyFingerprint String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?
  mediaExpiresAt DateTime?
  providerCheckpointJson String?
  providerNextPollAt     DateTime?

  @@unique([userId, idempotencyKey])
  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([createdAt]) // DB-1: admin/insights does createdAt-range scans across ALL users
  @@index([mediaExpiresAt])
}

model ToolCallAudit {
  id           String   @id @default(cuid())
  userId       String?
  toolName     String
  status       String // ok | denied | error
  durationMs   Int?
  requestJson  String?
  responseJson String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([toolName, createdAt])
}

enum Role {
  ADMIN
  USER
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Language {
  TH
  EN
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  VIDEO_COMPLETED
  VIDEO_FAILED
  LIMIT_WARNING
  LIMIT_REACHED
  NEW_USER
  ERROR_SYSTEM
}

model ProductUpdate {
  id          String                  @id @default(cuid())
  version     String
  title       String
  summary     String
  body        String?
  category    ProductUpdateCategory   @default(IMPROVEMENT)
  importance  ProductUpdateImportance @default(BANNER)
  state       ProductUpdateState      @default(DRAFT)
  isPinned    Boolean                 @default(false)
  targetPath  String?
  ctaLabel    String?
  ctaHref     String?
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  reads       ProductUpdateRead[]

  @@index([state, publishedAt])
  @@index([category, publishedAt])
  @@index([isPinned, publishedAt])
}

model ProductUpdateRead {
  id       String        @id @default(cuid())
  updateId String
  update   ProductUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime      @default(now())

  @@unique([updateId, userId])
  @@index([userId, readAt])
}

enum ProductUpdateCategory {
  FEATURE
  IMPROVEMENT
  FIX
  PATCH
  KNOWN_ISSUE
  IN_PROGRESS
}

enum ProductUpdateImportance {
  SILENT
  BANNER
  MODAL
}

enum ProductUpdateState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SupportTicket {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           String
  imageBase64       String?
  imageName         String?
  imageMimeType     String?
  status            SupportTicketStatus @default(OPEN)
  adminReply        String?
  category          String?
  severity          String?
  recommendedAction String?
  auditNote         String?
  impactNote        String?
  auditedAt         DateTime?
  repliedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  plan                  Plan               @default(PRO)
  durationDays          Int                @default(30) // 0 = permanent
  maxUses               Int                @default(1)
  usedCount             Int                @default(0)
  expiresAt             DateTime?
  type                  String             @default("GRANT") // GRANT | DISCOUNT
  percentOff            Int? // 1-100, DISCOUNT only
  discountDuration      String? // "once" | "forever", DISCOUNT only
  stripeCouponId        String? // Stripe Coupon id (DISCOUNT)
  stripePromotionCodeId String? // Stripe Promotion Code id (DISCOUNT)
  createdAt             DateTime           @default(now())
  redemptions           CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now())

  @@unique([couponId, userId])
}

// MON-10 (audited 2026-07-07): a user can legitimately churn through RESERVED → RELEASED →
// RESERVED (abandoned checkout, retry) many times, so `@@unique([userId])` on this table would
// wrongly forbid a normal retry. What we actually want to guard is "one CONFIRMED row per user",
// which needs a PARTIAL/filtered unique index (`WHERE status = 'CONFIRMED'`) — SQLite/Prisma has
// no filtered-unique support, so that constraint isn't cleanly expressible here. Instead, the
// member-check + coupon-claim in `claimSeat()` (src/lib/founding.ts) run inside one
// `$transaction` — see the comment there for exactly what race that closes and what it doesn't.
model FoundingReservation {
  id              String    @id @default(cuid())
  userId          String
  stripeSessionId String    @unique
  status          String    @default("RESERVED") // RESERVED | CONFIRMED | RELEASED
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  releasedAt      DateTime?

  @@index([userId])
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId     String        @unique
  stripePaymentIntent String?
  plan                Plan
  amount              Int // satang / cents
  currency            String        @default("thb")
  status              PaymentStatus @default(PENDING)
  periodDays          Int           @default(30)
  createdAt           DateTime      @default(now())
  paidAt              DateTime?
  // Off-Stripe (bank-transfer / external) payments recorded by an admin. Additive; a manual
  // PAID row counts in revenue-cohorts (จ่ายจริง/MRR/cash) exactly like a Stripe one. See
  // src/app/api/admin/manual-payment/route.ts. Never hard-deleted — soft-voided to VOIDED.
  manual              Boolean       @default(false)
  note                String? // admin free-text (e.g. "โอนธนาคาร · founder")
  recordedBy          String? // admin userId who recorded it

  @@index([status]) // DB-1: admin/insights + revenue-cohorts filter/scan by status (previously zero indexes besides the PK/unique)
}

// Idempotency ledger for Stripe webhooks. Stripe delivers events "at least once"; we record
// each processed event.id and skip duplicates so plan activation / renewal extension can't run
// twice for the same event. Additive table — flag-independent.
model StripeWebhookEvent {
  id          String   @id // Stripe event.id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

model TelemetryEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  name       String
  category   String   @default("product") // product | pipeline | performance | error
  source     String   @default("client") // client | server
  path       String?
  step       String?
  status     String?
  durationMs Int?
  value      Float?
  properties String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([category, createdAt])
  @@index([step, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOIDED // admin soft-void of a MANUAL payment — drops out of PAID cohorts, keeps the audit row
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Physical media catalog for the local -> R2 migration. Existing Video/VideoJob
// URLs remain authoritative ownership references; this row records where the
// immutable bytes are stored and whether the remote copy has been verified.
model MediaObject {
  id             String   @id @default(cuid())
  area           String
  filename       String
  objectKey      String   @unique
  contentType    String
  sizeBytes      BigInt
  sha256         String?
  remoteFilename String?
  r2Etag         String?
  remoteState    String   @default("none")
  localState     String   @default("present")
  localMtimeMs   BigInt?
  producedAt     DateTime @default(now())
  lastVerifiedAt DateTime?
  nextRetryAt    DateTime?
  lastErrorCode  String?
  attempts       Int      @default(0)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([area, filename])
  @@index([remoteState, nextRetryAt])
  @@index([localState, producedAt])
}

model Music {
  id        String   @id @default(cuid())
  title     String
  filename  String // file stored in public/music/
  duration  Float? // seconds
  createdAt DateTime @default(now())
}

model UserMusic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  filename  String   @unique // file stored in public/music/
  sizeBytes Int      @default(0)
  mimeType  String?
  duration  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model GeneratedImage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt       String
  url          String
  imageModel   String
  sceneTitle   String?
  contentTitle String?
  createdAt    DateTime @default(now())
}

// Shared durable job record for customer-facing AI Studio generations. Provider
// credentials/workflows stay server-side; the browser only receives this safe
// projection. Image credit reservations record the exact source buckets so a
// failed provider job can refund granted/purchased credits without changing
// their expiry semantics. Voice jobs use plan audio-minutes and therefore keep
// creditCost=0.
model AiGenerationJob {
  id                            String                @id @default(cuid())
  userId                        String
  user                          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                          String // image | voice
  provider                      String // runpod | kie | omnivoice
  model                         String // customer-selected offer/model id
  providerModel                 String? // exact provider model actually submitted
  providerRoute                 String? // runpod-public | runpod-custom | kie-market
  providerEndpoint              String? // exact endpoint/market seam used for durable polling
  quoteVersion                  String?
  costBudgetUsdMicros           Int?
  estimatedCostUsdMicros        Int?
  providerReportedCostUsdMicros Int?
  providerReportedCredits       Float?
  status                        String                @default("queued") // queued | in_progress | completed | failed | canceled
  inputPreview                  String?
  inputJson                     String?
  outputUrl                     String?
  providerJobId                 String?
  generatedImageId              String?
  creditCost                    Int                   @default(0)
  creditsFromGranted            Int                   @default(0)
  creditsFromPurchased          Int                   @default(0)
  chargeState                   String                @default("pending") // pending | reserved | settled | refunded | none
  errorCode                     String?
  errorMessage                  String?
  delayTimeMs                   Int?
  executionTimeMs               Int?
  idempotencyKey                String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  startedAt                     DateTime?
  finishedAt                    DateTime?
  mediaExpiresAt                DateTime?
  attempts                      AiGenerationAttempt[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([providerJobId])
  @@index([status, kind])
  @@index([mediaExpiresAt])
  // Covers the stale-reserved credit sweep (src/lib/ai-image-reconcile.ts), which
  // scans kind + chargeState against an updatedAt cutoff every 15 minutes.
  @@index([kind, chargeState, updatedAt])
}

// Every external provider submission is durable and auditable. Image jobs may
// retry the exact same provider/model once after a confirmed cancellation. A
// different-model retry remains a new quoted job so it cannot silently inherit
// the first job's lower credit price.
model AiGenerationAttempt {
  id                            String          @id @default(cuid())
  jobId                         String
  job                           AiGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence                      Int
  provider                      String
  providerModel                 String
  providerRoute                 String
  providerEndpoint              String?
  providerJobId                 String?
  status                        String          @default("planned") // planned | submitting | submitted | queued | in_progress | completed | failed | canceled
  estimatedCostUsdMicros        Int
  providerReportedCostUsdMicros Int?
  providerReportedCredits       Float?
  errorCode                     String?
  errorMessage                  String?
  createdAt                     DateTime        @default(now())
  submittedAt                   DateTime?
  finishedAt                    DateTime?

  @@unique([jobId, sequence])
  @@index([provider, providerJobId])
  @@index([status, createdAt])
}

// Hourly provider invoices for the private RunPod image endpoint. The numerator
// deliberately includes worker initialization, execution, idle time, failed
// attempts, retries, and operational smokes. Product COGS can therefore be
// compared against a managed per-image API without hiding infrastructure waste.
model RunpodBillingBucket {
  id              String   @id @default(cuid())
  endpointId      String
  bucketStart     DateTime
  gpuTypeId       String
  amountUsdMicros Int
  timeBilledMs    Int
  syncedAt        DateTime @updatedAt

  @@unique([endpointId, bucketStart, gpuTypeId])
  @@index([endpointId, bucketStart])
}

// A separate checkpoint makes an empty-but-successful billing response
// distinguishable from a broken sync. Admission can fail closed when telemetry
// becomes stale without inventing a cost for a brand-new endpoint.
model RunpodBillingSync {
  endpointId      String    @id
  lastWindowStart DateTime
  lastWindowEnd   DateTime
  lastSuccessAt   DateTime?
  rowsSeen        Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

// Records which base-render outputs a user has been CHARGED a clip for, so a
// later BURN (subtitle overlay) of that same render can be FREE without being
// gameable: a burn is free only when (userId, outputUrl) is found here. External
// / foreign / fabricated burn sources are NOT recorded → they fall through to a
// normal charge. outputUrl is the canonical `/api/renders/<file>` form (see
// src/lib/clip-charge.ts canonicalRenderUrl). Additive table — no FK/cascade,
// safe to `prisma db push`.
model ChargedClip {
  id             String   @id @default(cuid())
  userId         String
  outputUrl      String // the base render's output, e.g. /api/renders/render-….mp4
  chargedMinutes Int? // minutes charged for this video; null = legacy/clips-mode
  creditsSpent   Int? // credits charged for a credit-funded (overflow) render; null = minute/clip-funded
  createdAt      DateTime @default(now())

  @@index([userId, outputUrl])
}

model CreditBalance {
  userId         String    @id
  granted        Int       @default(0)
  purchased      Int       @default(0)
  grantedResetAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// MON-8 (audited 2026-07-07): do NOT add `@@unique([userId, action])` here. It looks like an
// obvious dedup key but it's WRONG — `action` is a legitimately repeatable label, not a per-row
// key. `spendCredits`/`refundCredits` are called with constant action strings like "ai-image" or
// "render-overflow" (see src/app/api/videos/fetch-stock/route.ts, src/lib/minute-credits.ts) —
// EVERY spend/refund of that kind for a user reuses the exact same string, so many legitimate
// rows share one (userId, action) pair. The real one-time-only dedup lives in `grantCreditsOnce`,
// which keys on a UNIQUE ref per event (e.g. "pack:<stripeSessionId>") via a `findFirst` check
// before granting — that's what actually prevents a double Stripe-webhook-retry grant, not a
// table constraint on this model.
model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  kind         String // grant | purchase | spend | expire
  action       String?
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model RenderJob {
  id                 String    @id @default(cuid())
  userId             String
  videoId            String? // gallery Video row, set when known
  parentJobId        String? // VideoJob.id when created by the MCP orchestrator; null for web jobs
  type               String // RENDER | BURN
  status             String    @default("QUEUED") // QUEUED|RUNNING|DONE|FAILED|CANCELLED
  attempts           Int       @default(0)
  maxAttempts        Int       @default(2)
  payload            String // JSON: full render config — no in-memory dependence
  progress           Float     @default(0)
  phase              String? // bundling | rendering | encoding
  heartbeatAt        DateTime?
  cancelRequested    Boolean   @default(false)
  reservedQuota      Boolean   @default(false) // true iff THIS job reserved a clip for its video
  reservedMinutes    Int? // minutes reserved for a queued job; for exact refund
  creditsSpent       Int? // credits spent to fund this render via overflow (null = minute/clip-funded); for bucket-aware refund
  creditsFromGranted Int? // of creditsSpent, the portion drained from the granted (monthly) bucket; the rest came from purchased — for an EXACT per-bucket refund (granted-back-to-granted, not inflated into purchased)
  error              String? // JSON, PR-5 error taxonomy
  idempotencyKey     String?   @unique
  scopeKey           String? // queue-path supersession scope = `${userId}:${renderScopeId}`; null when no jobScopeId (e.g. some MCP jobs)
  videoUrl           String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?

  @@index([status, type])
  @@index([userId, createdAt])
  @@index([parentJobId])
  @@index([scopeKey, status])
  @@index([createdAt]) // DB-1: admin/insights createdAt-range scans across ALL users (userId,createdAt above doesn't serve that)
}

// Anti-farming guard for MON-5 (2026-07-07): trialStartedAt on User is a "set once,
// never cleared" one-trial-per-user guard, but it's destroyed the moment a User row is
// hard-deleted (account delete via Clerk user.deleted webhook) — re-registering the same
// email then creates a fresh row with trialStartedAt=null and earns another free trial,
// repeatably. This table is independent of the User row's lifecycle: written once when a
// trial is granted, keyed by a normalized hash of the email (never the raw email, so a DB
// dump doesn't leak addresses), and checked BEFORE granting so a delete+re-signup with the
// same email can't re-earn a trial. Purely additive; no FK to User (must outlive it).
model UsedTrialEmail {
  id        String   @id @default(cuid())
  emailHash String   @unique // sha256(lowercase(trim(email)))
  createdAt DateTime @default(now())
}
