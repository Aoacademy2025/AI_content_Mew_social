# ClipForge desktop API. Set to 1 to enable every /api/desktop/* route.
# Unset or any other value keeps the surface inert (403 DESKTOP_DISABLED).
DESKTOP_APP=

# Comma-separated Hero AI user ids invited to the desktop app.
# Empty / unset = everyone when DESKTOP_APP=1. Non-empty = only listed ids
# (others get 403 DESKTOP_NOT_INVITED). Never put secrets here.
DESKTOP_ALLOWLIST=
